{
  "expo": {
    "name": "Tripivo",
    "slug": "tripivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tripivo uses your location to show trips and travelers near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tripivo needs your photos so you can pick a profile picture.",
          "cameraPermission": "Tripivo uses the camera so you can take a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#1D6AE5"
        }
      ]
    ],
    "scheme": "tripivo"
  }
}
