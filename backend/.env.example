PORT=4000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE. URL-encode special characters in the password
# (e.g. @ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres:YourStrongPassword123!@127.0.0.1:5432/postgres

# Comma-separated Google OAuth client IDs whose ID tokens the API accepts (web, iOS, Android).
GOOGLE_CLIENT_IDS=
# Signs Tripivo session tokens. Generate one with: openssl rand -base64 32
SESSION_SECRET=
