# Copy to backend/.env. Everything is read and validated in src/config/env.ts.

PORT=4000
# With `docker compose up -d` from the repo root:
DATABASE_URL=postgres://tripivo:tripivo@localhost:5432/tripivo
# Signs session tokens. Without it a random one is used and sessions end on every restart.
SESSION_SECRET=
# Number of reverse proxies in front of the API (1 behind ngrok or a load balancer).
TRUST_PROXY=0

# --- Infrastructure -------------------------------------------------------------------------
# Cache, rate limits and cross-instance real-time events (typing). Optional in development
# (without it they live in this process's memory, single instance only); required in production.
# Managed Redis uses TLS and a password: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379
# Namespaces every key and channel, so e.g. staging and production can share one server.
# REDIS_KEY_PREFIX=tripivo:
# Requests per minute per client IP across the API (0 turns the limit off).
API_RATE_LIMIT_PER_MINUTE=300
# One log line per request; JSON when NODE_ENV=production.
LOG_REQUESTS=true

# Uploaded files: "local" (UPLOAD_DIR, served from /uploads; one server only) or "s3"
# (AWS S3, Cloudflare R2, or the MinIO in docker-compose.yml).
STORAGE_PROVIDER=local
# UPLOAD_DIR=/var/lib/tripivo/uploads
# STORAGE_PROVIDER=s3
# S3_BUCKET=tripivo
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=tripivo
# S3_SECRET_ACCESS_KEY=tripivo-secret
# S3_PUBLIC_URL=http://localhost:9000/tripivo

# Push notifications go through Expo's push service. Only needed if "enhanced push security"
# is turned on for the Expo project.
# EXPO_ACCESS_TOKEN=

# --- Google sign-in -------------------------------------------------------------------------
GOOGLE_CLIENT_IDS=
# Server-side flow for Expo Go. <PUBLIC_API_URL>/api/auth/google/callback must be a redirect URI.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
PUBLIC_API_URL=
OAUTH_RETURN_URL_PREFIXES=tripivo://

# --- Phone sign-in: "console" (development only) or "twilio" --------------------------------
OTP_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Email: "console" (development only), "smtp" or "resend" --------------------------------
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# RESEND_API_KEY=
# EMAIL_FROM=Tripivo <no-reply@yourdomain.com>

# --- Places: "photon" (OpenStreetMap, no key) or "google" -----------------------------------
PLACES_PROVIDER=photon
# PHOTON_URL=https://photon.komoot.io
# GOOGLE_PLACES_API_KEY=

# --- Development only (refused when NODE_ENV=production) ------------------------------------
# Accepted for every phone and email verification.
DEV_MASTER_OTP=654321
# POST /api/auth/dev-login signs in as the seeded demo account.
DEV_LOGIN=true
